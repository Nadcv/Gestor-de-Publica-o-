<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Gestão de Pedidos - Publicações</title>
    <style>
        * {
            box-sizing: border-box;
            font-family: system-ui, 'Segoe UI', 'Roboto', 'Helvetica Neue', sans-serif;
        }
        body {
            background: #f4f7fc;
            margin: 0;
            padding: 20px;
            color: #1e2a3a;
        }
        .container {
            max-width: 1300px;
            margin: 0 auto;
        }
        h1 {
            font-size: 1.8rem;
            margin-bottom: 0.25rem;
            color: #0f3b5c;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .sub {
            color: #2c5a74;
            margin-bottom: 2rem;
            border-left: 4px solid #2c7da0;
            padding-left: 16px;
            font-weight: 500;
        }
        .dashboard {
            display: flex;
            flex-wrap: wrap;
            gap: 24px;
        }
        .card {
            background: white;
            border-radius: 28px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.05), 0 2px 4px rgba(0,0,0,0.02);
            padding: 1.5rem;
            transition: all 0.2s;
            border: 1px solid #e2edf2;
        }
        .card-header {
            font-weight: 700;
            font-size: 1.4rem;
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid #cbdde6;
            display: flex;
            align-items: center;
            gap: 8px;
            color: #1f5068;
        }
        .book-section {
            flex: 1.2;
            min-width: 260px;
        }
        .order-section {
            flex: 2;
            min-width: 320px;
        }
        .reports-section {
            flex: 2;
            min-width: 340px;
        }
        .form-group {
            margin-bottom: 1.2rem;
        }
        label {
            font-weight: 600;
            display: block;
            margin-bottom: 6px;
            color: #1f5068;
            font-size: 0.85rem;
        }
        input, select, textarea {
            width: 100%;
            padding: 10px 14px;
            border: 1.5px solid #cbdde6;
            border-radius: 20px;
            font-size: 0.9rem;
            background: #fff;
            transition: 0.2s;
        }
        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: #2c7da0;
            box-shadow: 0 0 0 2px rgba(44,125,160,0.2);
        }
        button {
            background: #2c7da0;
            color: white;
            border: none;
            padding: 10px 18px;
            border-radius: 40px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
            font-size: 0.85rem;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        button:hover {
            background: #1f5e7a;
            transform: scale(0.97);
        }
        .btn-secondary {
            background: #6c8b9b;
        }
        .btn-secondary:hover {
            background: #527282;
        }
        .btn-outline {
            background: transparent;
            border: 1.5px solid #2c7da0;
            color: #2c7da0;
        }
        .btn-outline:hover {
            background: #e6f4fa;
            transform: none;
        }
        .book-list {
            margin-top: 1rem;
            background: #f9fdfe;
            border-radius: 20px;
            padding: 0.5rem;
            max-height: 220px;
            overflow-y: auto;
        }
        .book-item {
            background: white;
            padding: 8px 12px;
            margin: 6px 0;
            border-radius: 40px;
            border: 1px solid #dce9f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .book-name {
            font-weight: 500;
        }
        .order-item {
            background: #ffffff;
            border-radius: 20px;
            padding: 14px;
            margin-bottom: 12px;
            border-left: 5px solid #2c7da0;
            box-shadow: 0 2px 6px rgba(0,0,0,0.03);
            transition: 0.1s;
        }
        .order-info {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: baseline;
            gap: 10px;
            margin-bottom: 10px;
        }
        .order-name {
            font-weight: 800;
            font-size: 1rem;
        }
        .order-book {
            background: #eef3f7;
            padding: 3px 12px;
            border-radius: 30px;
            font-size: 0.8rem;
        }
        .order-meta {
            font-size: 0.75rem;
            color: #5f7f92;
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 6px;
        }
        .btn-report {
            background: #446d82;
            padding: 5px 12px;
            font-size: 0.75rem;
            border-radius: 50px;
        }
        .modal {
            display: none;
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background-color: rgba(0,0,0,0.5);
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }
        .modal-content {
            background: white;
            max-width: 500px;
            width: 90%;
            border-radius: 32px;
            padding: 1.8rem;
            box-shadow: 0 20px 35px rgba(0,0,0,0.2);
            position: relative;
        }
        .modal-header {
            font-size: 1.5rem;
            font-weight: bold;
            margin-bottom: 1rem;
            color: #0f3b5c;
        }
        .report-detail {
            background: #f2f9fc;
            padding: 1rem;
            border-radius: 24px;
            margin: 1rem 0;
            line-height: 1.5;
        }
        .close-modal {
            float: right;
            font-size: 26px;
            cursor: pointer;
        }
        hr {
            margin: 16px 0;
            border-color: #cbdde6;
        }
        .badge {
            background: #d9eef5;
            padding: 2px 10px;
            border-radius: 30px;
            font-size: 0.7rem;
            font-weight: 600;
        }
        footer {
            text-align: center;
            margin-top: 2rem;
            font-size: 0.75rem;
            color: #5f7f92;
        }
        @media (max-width: 780px) {
            body { padding: 12px; }
            .card { padding: 1rem; }
        }
    </style>
</head>
<body>
<div class="container">
    <h1>📚 Pedidos de Publicações</h1>
    <div class="sub">Cadastro de livros · Pedidos com pré-preenchimento manual/digital · Relatório por pedido</div>

    <div class="dashboard">
        <!-- COLUNA ESQUERDA: GERENCIAR LIVROS -->
        <div class="card book-section">
            <div class="card-header">📖 Acervo de Livros</div>
            <div class="form-group">
                <label>➕ Inserir novo livro no sistema</label>
                <div style="display: flex; gap: 8px;">
                    <input type="text" id="newBookName" placeholder="Ex: O Alquimista, 1984..." style="flex:1;">
                    <button id="addBookBtn">Adicionar</button>
                </div>
            </div>
            <div><strong>📌 Livros disponíveis:</strong></div>
            <div id="booksListContainer" class="book-list">
                <div style="color:#8ba0ab; text-align:center; padding: 12px;">Nenhum livro cadastrado</div>
            </div>
            <button id="demoBooksBtn" class="btn-secondary" style="margin-top: 12px; width:100%;">📘 Carregar livros exemplo</button>
        </div>

        <!-- COLUNA CENTRAL: FORMULÁRIO DE PEDIDO (pré-preenchido manual/digital) -->
        <div class="card order-section">
            <div class="card-header">✍️ Novo Pedido</div>
            <div class="form-group">
                <label>👤 Nome da pessoa</label>
                <input type="text" id="personName" placeholder="Nome completo do solicitante">
            </div>
            <div class="form-group">
                <label>📘 Selecione o livro</label>
                <select id="bookSelect">
                    <option value="">-- Nenhum livro cadastrado --</option>
                </select>
            </div>
            <div class="form-group">
                <label>📄 Tipo de pedido (pré-preenche observação)</label>
                <select id="orderTypeSelect">
                    <option value="manual">📦 Manual (retirada física)</option>
                    <option value="digital">💻 Digital (envio por e-mail)</option>
                </select>
            </div>
            <div class="form-group">
                <label>📝 Observações / detalhes (pré-preenchido automático)</label>
                <textarea id="orderNotes" rows="2" placeholder="Observações do pedido..."></textarea>
                <small style="color:#446d82;">✔️ O campo é preenchido automaticamente conforme tipo selecionado. Você pode editar.</small>
            </div>
            <button id="createOrderBtn">✅ Cadastrar Pedido</button>
        </div>

        <!-- COLUNA DIREITA: LISTA DE PEDIDOS E RELATÓRIOS -->
        <div class="card reports-section">
            <div class="card-header">📋 Pedidos realizados</div>
            <div id="ordersListContainer" style="max-height: 480px; overflow-y: auto;">
                <div style="color:#8ba0ab; text-align:center; padding: 20px;">Nenhum pedido cadastrado</div>
            </div>
            <button id="clearOrdersDemo" class="btn-outline" style="margin-top: 12px; width:100%;">🗑️ Limpar todos os pedidos</button>
        </div>
    </div>
    <footer>
        🧾 Relatório de cada pedido: clique em "Ver Relatório" → visualização completa. Dados salvos localmente.
    </footer>
</div>

<!-- MODAL DE RELATÓRIO -->
<div id="reportModal" class="modal">
    <div class="modal-content">
        <span class="close-modal" id="closeModalBtn">&times;</span>
        <div class="modal-header">📄 Relatório do Pedido</div>
        <div id="reportContent" class="report-detail">
            <!-- Conteúdo dinâmico -->
        </div>
        <button id="modalCloseBtn" class="btn-secondary" style="margin-top: 12px;">Fechar</button>
    </div>
</div>

<script>
    // ----- MODELOS DE DADOS -----
    let books = [];        // array de strings (nomes)
    let orders = [];       // array de objetos { id, personName, bookName, orderType, notes, date, timestamp }

    // Chaves localStorage
    const STORAGE_BOOKS = "pub_books";
    const STORAGE_ORDERS = "pub_orders";

    // Elementos DOM
    const booksListDiv = document.getElementById("booksListContainer");
    const bookSelect = document.getElementById("bookSelect");
    const personNameInput = document.getElementById("personName");
    const orderTypeSelect = document.getElementById("orderTypeSelect");
    const orderNotesTextarea = document.getElementById("orderNotes");
    const ordersListDiv = document.getElementById("ordersListContainer");
    const addBookBtn = document.getElementById("addBookBtn");
    const createOrderBtn = document.getElementById("createOrderBtn");
    const demoBooksBtn = document.getElementById("demoBooksBtn");
    const clearOrdersDemo = document.getElementById("clearOrdersDemo");

    // Modal elementos
    const modal = document.getElementById("reportModal");
    const reportContentDiv = document.getElementById("reportContent");
    const closeModalBtn = document.getElementById("closeModalBtn");
    const modalCloseBtn = document.getElementById("modalCloseBtn");

    // ========== FUNÇÕES AUXILIARES ==========
    function saveBooksToLocal() {
        localStorage.setItem(STORAGE_BOOKS, JSON.stringify(books));
    }

    function saveOrdersToLocal() {
        localStorage.setItem(STORAGE_ORDERS, JSON.stringify(orders));
    }

    function loadBooksFromLocal() {
        const stored = localStorage.getItem(STORAGE_BOOKS);
        if(stored) {
            books = JSON.parse(stored);
        } else {
            books = [];
        }
    }

    function loadOrdersFromLocal() {
        const stored = localStorage.getItem(STORAGE_ORDERS);
        if(stored) {
            orders = JSON.parse(stored);
        } else {
            orders = [];
        }
    }

    // Atualiza lista de livros na UI + select
    function renderBooksList() {
        if(!books.length) {
            booksListDiv.innerHTML = `<div style="color:#8ba0ab; text-align:center; padding: 12px;">📭 Nenhum livro cadastrado. Adicione livros ao sistema.</div>`;
        } else {
            booksListDiv.innerHTML = books.map((book, idx) => `
                <div class="book-item">
                    <span class="book-name">📘 ${escapeHtml(book)}</span>
                    <button class="btn-outline" style="padding:2px 12px; font-size:0.7rem;" data-book-index="${idx}" data-book-name="${escapeHtml(book)}">🗑️</button>
                </div>
            `).join('');
            document.querySelectorAll('[data-book-index]').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const idx = parseInt(btn.getAttribute('data-book-index'));
                    if(!isNaN(idx) && idx >=0 && idx < books.length) {
                        if(confirm(`Remover o livro "${books[idx]}" do sistema? Isso não afeta pedidos já realizados.`)) {
                            books.splice(idx, 1);
                            saveBooksToLocal();
                            renderBooksList();
                            renderBookSelect();
                            renderOrdersList();
                        }
                    }
                    e.stopPropagation();
                });
            });
        }
        renderBookSelect();
    }

    function renderBookSelect() {
        if(!books.length) {
            bookSelect.innerHTML = `<option value="">-- Nenhum livro disponível --</option>`;
            bookSelect.disabled = true;
        } else {
            bookSelect.disabled = false;
            bookSelect.innerHTML = `<option value="" disabled selected>-- Selecione um livro --</option>` + 
                books.map(book => `<option value="${escapeHtml(book)}">${escapeHtml(book)}</option>`).join('');
        }
    }

    function prefillNotesByType() {
        const tipo = orderTypeSelect.value;
        if(tipo === 'manual') {
            orderNotesTextarea.value = "📦 Pedido MANUAL: retirada em ponto físico. Aguardar contato para combinar horário. (Pré-preenchido)";
        } else if(tipo === 'digital') {
            orderNotesTextarea.value = "💻 Pedido DIGITAL: envio por e-mail (anexo ou link). Verificar caixa de entrada. (Pré-preenchido)";
        } else {
            orderNotesTextarea.value = "";
        }
    }

    function renderOrdersList() {
        if(!orders.length) {
            ordersListDiv.innerHTML = `<div style="color:#8ba0ab; text-align:center; padding: 20px;">📭 Nenhum pedido realizado ainda.</div>`;
            return;
        }
        const sortedOrders = [...orders].sort((a,b) => (b.timestamp || 0) - (a.timestamp || 0));
        ordersListDiv.innerHTML = sortedOrders.map(order => {
            const dateStr = order.date ? order.date : new Date(order.timestamp).toLocaleString();
            const tipoExib = order.orderType === 'manual' ? '📦 Manual' : '💻 Digital';
            return `
                <div class="order-item" data-order-id="${order.id}">
                    <div class="order-info">
                        <span class="order-name">👤 ${escapeHtml(order.personName)}</span>
                        <span class="order-book">📖 ${escapeHtml(order.bookName)}</span>
                        <span class="badge">${tipoExib}</span>
                    </div>
                    <div class="order-meta">
                        <span>🕒 ${dateStr}</span>
                        <button class="btn-report" data-order-id="${order.id}">📄 Ver Relatório</button>
                    </div>
                </div>
            `;
        }).join('');

        document.querySelectorAll('.btn-report').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const orderId = parseInt(btn.getAttribute('data-order-id'));
                const foundOrder = orders.find(o => o.id === orderId);
                if(foundOrder) {
                    showReportModal(foundOrder);
                } else {
                    alert("Pedido não encontrado.");
                }
                e.stopPropagation();
            });
        });
    }

    function showReportModal(order) {
        const tipoLegivel = order.orderType === 'manual' ? '📦 MANUAL (físico)' : '💻 DIGITAL (virtual)';
        const dataFormatada = order.date ? order.date : new Date(order.timestamp).toLocaleString();
        const observacoes = order.notes ? order.notes : "Sem observações adicionais.";

        const reportHTML = `
            <div style="font-family: monospace; white-space: pre-wrap;">
                <strong>🔖 ID do pedido:</strong> #${order.id}<br>
                <strong>👤 Nome do cliente:</strong> ${escapeHtml(order.personName)}<br>
                <strong>📘 Livro solicitado:</strong> ${escapeHtml(order.bookName)}<br>
                <strong>📌 Tipo:</strong> ${tipoLegivel}<br>
                <strong>📅 Data / Hora:</strong> ${dataFormatada}<br>
                <strong>📝 Observações:</strong><br>
                <div style="background:#eef3f7; padding:10px; border-radius:16px; margin-top:6px;">${escapeHtml(observacoes)}</div>
                <hr>
                <span style="font-size:0.75rem;">✅ Relatório gerado automaticamente - Pedido registrado no sistema.</span>
            </div>
        `;
        reportContentDiv.innerHTML = reportHTML;
        modal.style.display = "flex";
    }

    function addNewOrder() {
        const personName = personNameInput.value.trim();
        const selectedBook = bookSelect.value;
        const orderType = orderTypeSelect.value;
        let notes = orderNotesTextarea.value.trim();

        if(!personName) {
            alert("Por favor, informe o nome da pessoa.");
            return false;
        }
        if(!selectedBook || selectedBook === "") {
            alert("Selecione um livro válido no catálogo.");
            return false;
        }
        if(!orderType) {
            alert("Selecione o tipo (Manual/Digital).");
            return false;
        }

        if(notes === "") {
            notes = orderType === 'manual' ? "Pedido manual sem observações adicionais." : "Pedido digital sem observações adicionais.";
        }

        const newId = orders.length > 0 ? Math.max(...orders.map(o => o.id)) + 1 : 1;
        const now = new Date();
        const dateString = now.toLocaleString('pt-BR');
        const newOrder = {
            id: newId,
            personName: personName,
            bookName: selectedBook,
            orderType: orderType,
            notes: notes,
            date: dateString,
            timestamp: now.getTime()
        };
        orders.push(newOrder);
        saveOrdersToLocal();
        renderOrdersList();

        personNameInput.value = "";
        prefillNotesByType();
        if(books.length > 0) {
            bookSelect.selectedIndex = 1;
            if(bookSelect.options[1]) bookSelect.value = bookSelect.options[1].value;
        } else {
            bookSelect.value = "";
        }
        return true;
    }

    function addNewBook() {
        const newBook = document.getElementById("newBookName").value.trim();
        if(!newBook) {
            alert("Digite o nome do livro.");
            return;
        }
        if(books.some(book => book.toLowerCase() === newBook.toLowerCase())) {
            alert("Este livro já está cadastrado no sistema.");
            return;
        }
        books.push(newBook);
        saveBooksToLocal();
        renderBooksList();
        document.getElementById("newBookName").value = "";
    }

    function loadDemoBooks() {
        const demoList = ["O Pequeno Príncipe", "Dom Casmurro", "1984", "A Arte da Guerra", "Cem Anos de Solidão"];
        let added = 0;
        demoList.forEach(book => {
            if(!books.some(b => b.toLowerCase() === book.toLowerCase())) {
                books.push(book);
                added++;
            }
        });
        if(added) {
            saveBooksToLocal();
            renderBooksList();
            alert(`${added} livros de exemplo adicionados ao catálogo!`);
        } else {
            alert("Livros exemplo já existem no sistema.");
        }
    }

    function clearAllOrders() {
        if(confirm("⚠️ Tem certeza que deseja APAGAR TODOS os pedidos? Essa ação é irreversível.")) {
            orders = [];
            saveOrdersToLocal();
            renderOrdersList();
        }
    }

    function escapeHtml(str) {
        if(!str) return "";
        return str.replace(/[&<>]/g, function(m) {
            if(m === '&') return '&amp;';
            if(m === '<') return '&lt;';
            if(m === '>') return '&gt;';
            return m;
        });
    }

    function init() {
        loadBooksFromLocal();
        loadOrdersFromLocal();
        renderBooksList();
        renderOrdersList();
        prefillNotesByType();
        
        addBookBtn.addEventListener("click", addNewBook);
        createOrderBtn.addEventListener("click", addNewOrder);
        demoBooksBtn.addEventListener("click", loadDemoBooks);
        clearOrdersDemo.addEventListener("click", clearAllOrders);
        orderTypeSelect.addEventListener("change", prefillNotesByType);
        
        function closeModalFunc() {
            modal.style.display = "none";
        }
        closeModalBtn.addEventListener("click", closeModalFunc);
        modalCloseBtn.addEventListener("click", closeModalFunc);
        window.addEventListener("click", (e) => {
            if(e.target === modal) closeModalFunc();
        });
        
        if(books.length === 0) {
            bookSelect.disabled = true;
        } else {
            bookSelect.disabled = false;
        }
    }
    
    init();
</script>
</body>
</html>